config BR2_PACKAGE_OPENIPC_USBFPV
	bool "OpenIPC USB FPV profile"
	depends on !BR2_PACKAGE_MAJESTIC
	select BR2_PACKAGE_DIVINUS
	select BR2_PACKAGE_MSPOSD
	select BR2_PACKAGE_V4L2RTSPSERVER
	select BR2_PACKAGE_YAML_CLI
	help
	  Init scripts and configuration that turn the three packages
	  it selects into one firmware: Divinus serves the sensor as
	  H.264 over RTSP on port 554, v4l2rtspserver serves a UVC
	  camera's MJPEG over RTSP on port 8554, and msposd forwards
	  the flight controller's MSP DisplayPort stream from UART2 to
	  a ground station over UDP, where the OSD is drawn.

	  Board-specific by design, the way openipc-nfs-root is: the
	  files it installs would start a second streamer on any image
	  that carries majestic, hence the dependency.

comment "openipc-usbfpv is a majestic-free profile"
	depends on BR2_PACKAGE_MAJESTIC
