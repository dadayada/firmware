config BR2_PACKAGE_OPENIPC_USBFPV
	bool "OpenIPC USB FPV profile"
	depends on !BR2_PACKAGE_MAJESTIC
	depends on BR2_LINUX_KERNEL
	depends on BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY6E
	select BR2_PACKAGE_FPVCAM
	select BR2_PACKAGE_MSPOSD
	help
	  Init scripts and configuration that turn the packages it
	  selects into one firmware: fpvcam serves the sensor over RTSP
	  as rtsp://camera/main and a UVC camera as rtsp://camera/usb,
	  both on port 554, with a settings page on port 80; msposd
	  forwards the flight controller's MSP DisplayPort stream from
	  UART2 to a ground station over UDP, where the OSD is drawn.

	  The UVC camera this was built for, an InfiRay 384x288 thermal
	  core, offers only raw YUYV. fpvcam compresses it with a second
	  channel of the SoC's encoder, or with libjpeg-turbo when its
	  codec is set to mjpeg.

	  Board-specific by design, the way openipc-nfs-root is: the
	  files it installs would start a second streamer on any image
	  that carries majestic, hence the dependency.

comment "openipc-usbfpv is a majestic-free profile for infinity6e"
	depends on BR2_PACKAGE_MAJESTIC || !BR2_PACKAGE_SIGMASTAR_OSDRV_INFINITY6E
